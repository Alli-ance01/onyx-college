{
  "name": "onyx-college-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "22.19.0",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"pnpm --filter @onyx/api dev\" \"pnpm --filter @onyx/web dev\"",
    "build": "pnpm --recursive --workspace-concurrency=1 build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 typecheck",
    "pretest": "pnpm --filter @onyx/contracts build",
    "test": "pnpm --recursive --workspace-concurrency=1 --if-present test",
    "test:integration": "pnpm --filter @onyx/api test:integration",
    "test:e2e": "pnpm --filter @onyx/contracts build && playwright test --config apps/api/test/e2e/playwright.config.ts",
    "access:sync": "pnpm --filter @onyx/api access:sync",
    "bootstrap:super-admin": "pnpm --filter @onyx/api bootstrap:super-admin",
    "db:indexes": "pnpm --filter @onyx/api db:indexes",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "1.63.0",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
