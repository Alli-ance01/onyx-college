NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/onyx_college_portal?replicaSet=rs0
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_REPLAY_GRACE_SECONDS=8
AUTH_ISSUER=onyx-college-api
AUTH_AUDIENCE=onyx-college-portal
AUTH_COOKIE_NAME=onyx_refresh
AUTH_COOKIE_SECURE=false
# Use none with AUTH_COOKIE_SECURE=true when the web and API use different sites in production.
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_FAILED_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOCK_DURATION_SECONDS=900
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
STUDENT_SIGNUP_RATE_LIMIT_MAX=5
JSON_BODY_LIMIT=1mb
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_SIGNED_URL_TTL_SECONDS=120
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_PATH=.data/private-uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
